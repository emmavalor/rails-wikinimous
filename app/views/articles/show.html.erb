<%= link_to articles_path, class: "d-flex gap-3 align-items-center mb-3 link-dark link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover" do %>
    <i class="fa-solid fa-arrow-left"></i>
    <p class="m-0">Go back</p>
<% end %>

<div class="card shadow-sm mb-3">
  <div class="card-body">

    <div class="d-flex justify-content-between align-items-start">

      <div>
        <h5 class="card-title mb-1">
          <%= @article.title %>
        </h5>
        <small class="text-muted">
          <%= @article.created_at.strftime("%d/%m/%Y") %>
        </small>
      </div>

      <div class="d-flex gap-2">
        <%= link_to edit_path(@article),
            class: "text-primary" do %>
          <i class="fa-solid fa-pen-to-square"></i>
        <% end %>

        <%= link_to article_path(@article),
            data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
            class: "text-danger",
            title: "Delete article" do %>
          <i class="fa-solid fa-trash"></i>
        <% end %>
      </div>

    </div>

    <hr>

    <p class="card-text">
      <%= @article.content %>
    </p>

  </div>
</div>
